{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "customConditions": [
      "node"
    ],
    "noImplicitOverride": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
